FROM ubuntu:22.04

# 환경 변수 설정
ENV DEBIAN_FRONTEND=noninteractive
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV POSTGRES_DB=test_automation

# PostgreSQL 공식 저장소 추가
RUN apt-get update && apt-get install -y \
    gnupg2 \
    lsb-release \
    curl \
    wget \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list

# PostgreSQL, Java, Python 설치
RUN apt-get update && apt-get install -y \
    postgresql-15 \
    postgresql-contrib-15 \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Java 환경 변수 설정
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

# Allure Commandline 설치
RUN ALLURE_VERSION=$(curl -s https://api.github.com/repos/allure-framework/allure2/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/') && \
    wget -q "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" && \
    tar -xzf "allure-${ALLURE_VERSION}.tgz" -C /opt && \
    rm "allure-${ALLURE_VERSION}.tgz" && \
    ln -s /opt/allure-${ALLURE_VERSION}/bin/allure /usr/local/bin/allure && \
    chmod +x /usr/local/bin/allure

# PostgreSQL 초기화는 런타임에 수행

# 작업 디렉토리 설정
WORKDIR /workspace

# 볼륨 마운트 포인트
VOLUME ["/workspace", "/var/lib/postgresql/data"]

# 시작 스크립트 생성
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# PostgreSQL 데이터 디렉토리 초기화\n\
if [ ! -d /var/lib/postgresql/15/main ]; then\n\
    echo "Initializing PostgreSQL data directory..."\n\
    sudo -u postgres /usr/lib/postgresql/15/bin/initdb -D /var/lib/postgresql/15/main\n\
fi\n\
\n\
# PostgreSQL 설정\n\
echo "host all all 0.0.0.0/0 md5" >> /etc/postgresql/15/main/pg_hba.conf\n\
echo "listen_addresses = '\''*'\''" >> /etc/postgresql/15/main/postgresql.conf\n\
\n\
# PostgreSQL 시작\n\
service postgresql start\n\
sleep 2\n\
\n\
# PostgreSQL 사용자 및 DB 설정\n\
sudo -u postgres psql -c "ALTER USER postgres WITH PASSWORD '\''${POSTGRES_PASSWORD:-postgres}'\'';" || true\n\
sudo -u postgres createdb ${POSTGRES_DB:-test_automation} || true\n\
\n\
# DB 초기화 (스키마 파일이 있으면 실행)\n\
if [ -f /workspace/database/schema.sql ]; then\n\
    echo "Initializing database schema..."\n\
    sudo -u postgres psql -d ${POSTGRES_DB:-test_automation} -f /workspace/database/schema.sql || true\n\
fi\n\
\n\
# 영구 저장소의 Allure 결과를 allure-results로 병합\n\
if [ -d /workspace/allure-results-permanent ] && [ -n "$(ls -A /workspace/allure-results-permanent 2>/dev/null)" ]; then\n\
    echo "Merging permanent Allure results..."\n\
    mkdir -p /workspace/allure-results\n\
    cp -r /workspace/allure-results-permanent/* /workspace/allure-results/ 2>/dev/null || true\n\
    echo "Permanent results merged"\n\
fi\n\
\n\
# Allure 리포트 생성 및 서버 시작\n\
if [ -d /workspace/allure-results ] && [ -n "$(ls -A /workspace/allure-results 2>/dev/null)" ]; then\n\
    echo "Generating Allure report..."\n\
    allure generate /workspace/allure-results -o /workspace/allure-report --clean || true\n\
    echo "Report generated successfully"\n\
fi\n\
\n\
# Allure 리포트 서버 백그라운드 시작\n\
mkdir -p /workspace/allure-report\n\
cd /workspace/allure-report\n\
python3 -m http.server 5050 --bind 0.0.0.0 &\n\
SERVER_PID=$!\n\
\n\
# 주기적으로 Allure 리포트 재생성 (변화가 있을 때만)\n\
LAST_CHECKSUM=""\n\
while true; do\n\
    sleep 30\n\
    # 영구 저장소의 새로운 결과를 allure-results로 병합\n\
    if [ -d /workspace/allure-results-permanent ] && [ -n "$(ls -A /workspace/allure-results-permanent 2>/dev/null)" ]; then\n\
        mkdir -p /workspace/allure-results\n\
        # 영구 저장소의 파일 중 allure-results에 없는 것만 복사\n\
        for file in /workspace/allure-results-permanent/*; do\n\
            if [ -f "$file" ]; then\n\
                filename=$(basename "$file")\n\
                if [ ! -f "/workspace/allure-results/$filename" ]; then\n\
                    cp "$file" "/workspace/allure-results/"\n\
                    echo "New Allure result file added: $filename"\n\
                fi\n\
            fi\n\
        done\n\
    fi\n\
    \n\
    if [ -d /workspace/allure-results ] && [ -n "$(ls -A /workspace/allure-results 2>/dev/null)" ]; then\n\
        # allure-results 디렉토리의 파일들 체크섬 계산\n\
        CURRENT_CHECKSUM=$(find /workspace/allure-results -type f -exec md5sum {} \; 2>/dev/null | md5sum | cut -d'\'' '\'' -f1)\n\
        if [ "$CURRENT_CHECKSUM" != "$LAST_CHECKSUM" ]; then\n\
            echo "Allure results changed, regenerating report..."\n\
            allure generate /workspace/allure-results -o /workspace/allure-report --clean || true\n\
            LAST_CHECKSUM=$CURRENT_CHECKSUM\n\
            echo "Report regenerated successfully"\n\
        fi\n\
    fi\n\
done &\n\
\n\
# PostgreSQL과 Allure 서버가 계속 실행되도록 대기\n\
wait $SERVER_PID\n\
' > /start.sh && chmod +x /start.sh

# 포트 노출
EXPOSE 5432 5050

# 시작 스크립트 실행
CMD ["/start.sh"]

