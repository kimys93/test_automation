FROM ubuntu:22.04

# 환경 변수 설정
ENV DEBIAN_FRONTEND=noninteractive
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV POSTGRES_DB=test_automation

# PostgreSQL 공식 저장소 추가
RUN apt-get update && apt-get install -y \
    gnupg2 \
    lsb-release \
    curl \
    wget \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list

# sudo 먼저 설치
RUN apt-get update && apt-get install -y sudo && rm -rf /var/lib/apt/lists/*

# PostgreSQL, Java, Python, Node.js 설치
RUN apt-get update && apt-get install -y \
    postgresql-15 \
    postgresql-contrib-15 \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Java 환경 변수 설정 (아키텍처에 따라 자동 감지)
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
ENV PATH=$PATH:$JAVA_HOME/bin

# 작업 디렉토리 설정
WORKDIR /workspace

# 볼륨 마운트 포인트
VOLUME ["/workspace", "/var/lib/postgresql/data"]

# 시작 스크립트 생성
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# PostgreSQL 데이터 디렉토리 초기화 (볼륨 마운트 경로와 일치)\n\
if [ ! -d /var/lib/postgresql/data ]; then\n\
    echo "Initializing PostgreSQL data directory..."\n\
    sudo -u postgres /usr/lib/postgresql/15/bin/initdb -D /var/lib/postgresql/data\n\
fi\n\
\n\
# PostgreSQL 설정 파일 경로 수정\n\
PGDATA=/var/lib/postgresql/data\n\
if [ -f $PGDATA/pg_hba.conf ]; then\n\
    echo "host all all 0.0.0.0/0 md5" >> $PGDATA/pg_hba.conf\n\
    echo "listen_addresses = '\''*'\''" >> $PGDATA/postgresql.conf\n\
else\n\
    # 설정 파일이 없으면 기본 위치에서 복사\n\
    if [ -f /etc/postgresql/15/main/pg_hba.conf ]; then\n\
        echo "host all all 0.0.0.0/0 md5" >> /etc/postgresql/15/main/pg_hba.conf\n\
        echo "listen_addresses = '\''*'\''" >> /etc/postgresql/15/main/postgresql.conf\n\
    fi\n\
fi\n\
\n\
# PostgreSQL 시작 (데이터 디렉토리 지정)\n\
export PGDATA=/var/lib/postgresql/data\n\
sudo -u postgres /usr/lib/postgresql/15/bin/pg_ctl -D $PGDATA -l /var/log/postgresql/postgresql.log start || service postgresql start\n\
sleep 5\n\
\n\
# PostgreSQL이 완전히 시작될 때까지 대기\n\
until sudo -u postgres pg_isready -U postgres; do\n\
    echo "Waiting for PostgreSQL to start..."\n\
    sleep 1\n\
done\n\
\n\
# PostgreSQL 사용자 비밀번호 설정 (강제 재설정)\n\
echo "Setting PostgreSQL password..."\n\
sudo -u postgres psql -c "ALTER USER postgres WITH PASSWORD '\''${POSTGRES_PASSWORD:-postgres}'\'';" || true\n\
\n\
# DB 생성\n\
sudo -u postgres createdb ${POSTGRES_DB:-test_automation} 2>&1 || echo "Database may already exist"\n\
\n\
# 비밀번호 확인 (환경 변수로)\n\
export PGPASSWORD=${POSTGRES_PASSWORD:-postgres}\n\
if psql -h localhost -U postgres -d ${POSTGRES_DB:-test_automation} -c "SELECT 1;" > /dev/null 2>&1; then\n\
    echo "✅ PostgreSQL password verified"\n\
else\n\
    echo "⚠️ PostgreSQL password verification failed, but continuing..."\n\
fi\n\
\n\
# DB 초기화 (스키마 파일이 있으면 실행)\n\
if [ -f /workspace/database/schema.sql ]; then\n\
    echo "Initializing database schema..."\n\
    sudo -u postgres psql -d ${POSTGRES_DB:-test_automation} -f /workspace/database/schema.sql || true\n\
fi\n\
\n\
# PostgreSQL이 계속 실행되도록 대기\n\
tail -f /dev/null\n\
' > /start.sh && chmod +x /start.sh

# 포트 노출
EXPOSE 5432

# 시작 스크립트 실행
CMD ["/start.sh"]

