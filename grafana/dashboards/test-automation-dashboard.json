      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "__FIXED__"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  tc.test_name,\n  CASE \n    WHEN tc.steps IS NOT NULL AND tc.steps::text != 'null' AND tc.steps::text != '[]' THEN\n      COALESCE(\n        -- depth3 step 배열에서 직접 error 찾기 (현재 저장 구조)\n        (SELECT string_agg(step->>'title', ' > ')\n         FROM jsonb_array_elements(tc.steps::jsonb) AS step\n         WHERE step->'error' IS NOT NULL\n         LIMIT 10),\n        -- 또는 depth2->depth3 구조 (Mac 환경에서 저장된 경우)\n        (SELECT string_agg(d3_step->>'title', ' > ')\n         FROM jsonb_array_elements(tc.steps::jsonb) AS d2_step,\n              jsonb_array_elements(CASE WHEN jsonb_typeof(d2_step->'steps') = 'array' THEN d2_step->'steps' ELSE '[]'::jsonb END) AS d3_step\n         WHERE d2_step->'steps' IS NOT NULL\n           AND jsonb_typeof(d2_step->'steps') = 'array'\n           AND (d3_step->'error' IS NOT NULL OR d3_step->'statusDetails' IS NOT NULL)\n         LIMIT 10)\n      )\n    ELSE NULL\n  END AS error_steps,\n  tc.status,\n  tc.error_message,\n  tr.run_id,\n  COALESCE(tr.report_path, '') AS report_path,\n  COALESCE(tr.build_number, '') AS build_number,\n  tr.started_at\nFROM test_cases tc\nJOIN test_runs tr ON tc.test_run_id = tr.id\nWHERE tc.status = 'FAILED'\nORDER BY tr.started_at DESC, tc.test_name\nLIMIT 50",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Failed Test Error Logs",
      "type": "table"
    }
