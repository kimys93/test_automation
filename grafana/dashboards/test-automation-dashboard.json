          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ts.test_name,\n  ts.failure_rate,\n  COALESCE((SELECT tr.report_path FROM test_runs tr JOIN test_cases tc ON tr.id = tc.test_run_id WHERE tc.test_name = ts.test_name AND tc.status = 'FAILED' AND tr.report_path IS NOT NULL ORDER BY tr.started_at DESC LIMIT 1), '') as report_path,\n  COALESCE((SELECT tr.build_number FROM test_runs tr JOIN test_cases tc ON tr.id = tc.test_run_id WHERE tc.test_name = ts.test_name AND tc.status = 'FAILED' AND tr.report_path IS NOT NULL ORDER BY tr.started_at DESC LIMIT 1), '') as build_number\nFROM test_statistics ts\nWHERE ts.total_runs > 0 AND ts.test_name != 'Unknown Test'\nORDER BY ts.failure_rate DESC\nLIMIT 10",
          "refId": "A",
