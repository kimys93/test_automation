pipeline {
    agent any
    
    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'Test build number to get results from')
    }
    
    environment {
        // 인코딩 설정 (한글 지원)
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8 -Dconsole.encoding=UTF-8'
        PYTHONIOENCODING = 'UTF-8'
        LANG = 'ko_KR.UTF-8'
        LC_ALL = 'ko_KR.UTF-8'
    }
    
    stages {
        stage('Get Test Results') {
            steps {
                script {
                    def buildNumber = params.BUILD_NUMBER ?: "${env.BUILD_NUMBER}"
                    
                    // test_automation 파이프라인의 최신 빌드에서 아티팩트 가져오기
                    copyArtifacts(
                        projectName: 'test_automation',
                        selector: buildNumber ? specific(buildNumber) : lastSuccessful(),
                        filter: 'test-results/results.json',
                        target: '.',
                        flatten: true
                    )
                    
                    if (!fileExists('results.json')) {
                        error 'Test results file not found. Make sure test_automation job completed successfully.'
                    }
                }
            }
        }
        
        stage('Parse Test Results') {
            steps {
                script {
                    def resultsJson = readJSON file: 'results.json'
                    
                    // Playwright JSON 리포트 구조에 맞게 파싱 (클로저 없이 순수 반복문만 사용)
                    def totalTests = 0
                    def passedTests = 0
                    def failedTests = 0
                    def skippedTests = 0
                    
                    // 디버깅: JSON 구조 확인
                    echo "Parsing test results JSON..."
                    if (resultsJson.stats instanceof Map) {
                        echo "Found stats object: ${resultsJson.stats}"
                    }
                    if (resultsJson.suites instanceof List) {
                        echo "Found ${resultsJson.suites.size()} suites"
                    }
                    
                    // 방법 1: stats 객체 우선 사용 (가장 정확)
                    if (resultsJson.stats instanceof Map) {
                        totalTests = resultsJson.stats.total ?: 0
                        passedTests = resultsJson.stats.passed ?: 0
                        failedTests = resultsJson.stats.failed ?: 0
                        skippedTests = resultsJson.stats.skipped ?: 0
                        echo "Using stats object: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    }
                    
                    // 방법 2: stats가 없거나 0이면 suites 배열 직접 접근 (for 루프만 사용, 클로저 없음)
                    if (totalTests == 0 && resultsJson.suites instanceof List) {
                        echo "Stats not available, parsing suites array..."
                        for (int i = 0; i < resultsJson.suites.size(); i++) {
                            def suite = resultsJson.suites[i]
                            if (suite instanceof Map && suite.specs instanceof List) {
                                for (int j = 0; j < suite.specs.size(); j++) {
                                    def spec = suite.specs[j]
                                    if (spec instanceof Map && spec.tests instanceof List) {
                                        for (int k = 0; k < spec.tests.size(); k++) {
                                            def test = spec.tests[k]
                                            if (test instanceof Map) {
                                                totalTests++
                                                
                                                if (test.results instanceof List && test.results.size() > 0) {
                                                    def hasPassed = false
                                                    def hasFailed = false
                                                    def hasSkipped = false
                                                    
                                                    for (int l = 0; l < test.results.size(); l++) {
                                                        def result = test.results[l]
                                                        if (result instanceof Map && result.status) {
                                                            def status = result.status.toString()
                                                            if (status == 'passed') {
                                                                hasPassed = true
                                                            } else if (status == 'failed') {
                                                                hasFailed = true
                                                            } else if (status == 'skipped') {
                                                                hasSkipped = true
                                                            }
                                                        }
                                                    }
                                                    
                                                    if (hasPassed) {
                                                        passedTests++
                                                    } else if (hasFailed) {
                                                        failedTests++
                                                    } else if (hasSkipped) {
                                                        skippedTests++
                                                    } else {
                                                        skippedTests++
                                                    }
                                                } else {
                                                    skippedTests++
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        echo "Parsed from suites: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    }
                    
                    env.TEST_TOTAL = "${totalTests}"
                    env.TEST_PASSED = "${passedTests}"
                    env.TEST_FAILED = "${failedTests}"
                    env.TEST_SKIPPED = "${skippedTests}"
                    
                    echo "Final Test Summary: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    
                    if (totalTests == 0) {
                        echo "WARNING: Could not parse test results. JSON structure may be different."
                        if (resultsJson.containsKey('stats')) {
                            echo "Stats object exists but values are 0"
                        }
                        if (resultsJson.containsKey('suites')) {
                            echo "Suites array exists"
                        }
                    }
                }
            }
        }
        
        stage('Send to Slack') {
            steps {
                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
                    script {
                        def testJobUrl = "${env.JENKINS_URL}job/test_automation/"
                        def buildUrl = env.BUILD_URL ?: 'N/A'
                        def status = env.TEST_FAILED.toInteger() > 0 ? '❌ FAILED' : '✅ PASSED'
                        def color = env.TEST_FAILED.toInteger() > 0 ? 'danger' : 'good'
                        
                        // Slack 메시지 구성 (한글과 이모지 포함)
                        def message = """
🚀 *테스트 자동화 결과* ${status}

📊 *테스트 요약*
• 전체: ${env.TEST_TOTAL}
• ✅ Passed: ${env.TEST_PASSED}
• ❌ 실패: ${env.TEST_FAILED}
• ⏭️ 건너뜀: ${env.TEST_SKIPPED}

🔗 *링크*
• 테스트 리포트: ${testJobUrl}
• 빌드: ${buildUrl}
"""
                        
                        // Slack 전송 (HTTP POST)
                        def payload = [
                            text: message,
                            username: 'Jenkins Test Bot',
                            icon_emoji: ':robot_face:',
                            attachments: [[
                                color: color,
                                fields: [
                                    [title: '전체', value: env.TEST_TOTAL, short: true],
                                    [title: '통과', value: env.TEST_PASSED, short: true],
                                    [title: '실패', value: env.TEST_FAILED, short: true],
                                    [title: '건너뜀', value: env.TEST_SKIPPED, short: true]
                                ]
                            ]]
                        ]
                        
                        // UTF-8 인코딩으로 JSON 생성
                        def jsonPayload = groovy.json.JsonOutput.toJson(payload)
                        
                        // HTTP Request (customHeaders로 UTF-8 명시)
                        httpRequest(
                            httpMode: 'POST',
                            url: "${env.SLACK_WEBHOOK_URL}",
                            contentType: 'APPLICATION_JSON',
                            customHeaders: [[name: 'Content-Type', value: 'application/json; charset=utf-8']],
                            requestBody: jsonPayload,
                            validResponseCodes: '200:299'
                        )
                        
                        echo 'Slack notification sent successfully'
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Slack notification pipeline completed'
        }
        failure {
            echo 'Failed to send Slack notification'
        }
    }
}

