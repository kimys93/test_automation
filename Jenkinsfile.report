pipeline {
    agent any
    
    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'Test build number to get results from')
    }
    
    environment {
        // 인코딩 설정 (한글 지원)
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8 -Dconsole.encoding=UTF-8'
        PYTHONIOENCODING = 'UTF-8'
        LANG = 'ko_KR.UTF-8'
        LC_ALL = 'ko_KR.UTF-8'
    }
    
    stages {
        stage('Get Test Results') {
            steps {
                script {
                    def buildNumber = params.BUILD_NUMBER ?: "${env.BUILD_NUMBER}"
                    
                    // test_automation 파이프라인의 최신 빌드에서 아티팩트 가져오기
                    copyArtifacts(
                        projectName: 'test_automation',
                        selector: buildNumber ? specific(buildNumber) : lastSuccessful(),
                        filter: 'test-results/results.json',
                        target: '.',
                        flatten: true
                    )
                    
                    if (!fileExists('results.json')) {
                        error 'Test results file not found. Make sure test_automation job completed successfully.'
                    }
                    
                    // JSON 파일 크기 확인
                    def fileSize = bat(script: 'powershell -Command "(Get-Item results.json).Length"', returnStdout: true).trim()
                    echo "results.json file size: ${fileSize} bytes"
                    
                    if (fileSize == '0' || fileSize == '') {
                        error 'Test results file is empty. Make sure tests were executed and results.json was generated.'
                    }
                }
            }
        }
        
        stage('Parse Test Results') {
            steps {
                script {
                    // 디버깅: JSON 파일 읽기 전 인코딩 확인
                    echo "=== Step 1: Reading results.json ==="
                    def fileContent = readFile file: 'results.json', encoding: 'UTF-8'
                    echo "File read successfully, size: ${fileContent.length()} characters"
                    
                    // JSON 파싱
                    def resultsJson = readJSON text: fileContent
                    
                    // 디버깅: JSON에서 한글 문자열 확인
                    if (resultsJson.containsKey('suites') && resultsJson.suites instanceof List && resultsJson.suites.size() > 0) {
                        def firstSuite = resultsJson.suites[0]
                        if (firstSuite.containsKey('suites') && firstSuite.suites instanceof List && firstSuite.suites.size() > 0) {
                            def testSuite = firstSuite.suites[0]
                            echo "=== Step 2: Test suite title from JSON ==="
                            echo "Title: ${testSuite.title}"
                            echo "Title bytes: ${testSuite.title.getBytes('UTF-8')}"
                        }
                    }
                    
                    // Playwright JSON 리포트 구조에 맞게 파싱 (클로저 없이 순수 반복문만 사용)
                    def totalTests = 0
                    def passedTests = 0
                    def failedTests = 0
                    def skippedTests = 0
                    
                    // 디버깅: JSON 구조 확인
                    echo "=== Step 3: Parsing test results JSON ==="
                    
                    // stats 객체 확인 및 사용 (Playwright JSON 리포트 구조)
                    def statsFound = false
                    if (resultsJson.containsKey('stats') && resultsJson.stats instanceof Map) {
                        def stats = resultsJson.stats
                        // Playwright는 expected, unexpected, skipped, flaky를 사용
                        def expected = stats.containsKey('expected') && stats.expected instanceof Number ? stats.expected : 0
                        def unexpected = stats.containsKey('unexpected') && stats.unexpected instanceof Number ? stats.unexpected : 0
                        skippedTests = stats.containsKey('skipped') && stats.skipped instanceof Number ? stats.skipped : 0
                        def flaky = stats.containsKey('flaky') && stats.flaky instanceof Number ? stats.flaky : 0
                        
                        // Playwright 구조에 맞게 변환
                        totalTests = expected + unexpected + skippedTests + flaky
                        passedTests = expected
                        failedTests = unexpected
                        
                        statsFound = true
                        echo "Using stats object: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    }
                    
                    // stats가 없거나 0이면 suites 배열 파싱
                    if (!statsFound || totalTests == 0) {
                        if (resultsJson.containsKey('suites') && resultsJson.suites instanceof List) {
                            echo "Stats not available or zero, parsing ${resultsJson.suites.size()} suites..."
                            
                            // 카운터 초기화 (stats가 0이었을 경우)
                            if (statsFound && totalTests == 0) {
                                totalTests = 0
                                passedTests = 0
                                failedTests = 0
                                skippedTests = 0
                            }
                            
                            for (int i = 0; i < resultsJson.suites.size(); i++) {
                                def suite = resultsJson.suites[i]
                                if (suite instanceof Map && suite.containsKey('specs') && suite.specs instanceof List) {
                                    for (int j = 0; j < suite.specs.size(); j++) {
                                        def spec = suite.specs[j]
                                        if (spec instanceof Map && spec.containsKey('tests') && spec.tests instanceof List) {
                                            for (int k = 0; k < spec.tests.size(); k++) {
                                                def test = spec.tests[k]
                                                if (test instanceof Map) {
                                                    totalTests++
                                                    
                                                    if (test.containsKey('results') && test.results instanceof List && test.results.size() > 0) {
                                                        def hasPassed = false
                                                        def hasFailed = false
                                                        def hasSkipped = false
                                                        
                                                        for (int l = 0; l < test.results.size(); l++) {
                                                            def result = test.results[l]
                                                            if (result instanceof Map && result.containsKey('status')) {
                                                                def status = result.status.toString()
                                                                if (status == 'passed') {
                                                                    hasPassed = true
                                                                } else if (status == 'failed') {
                                                                    hasFailed = true
                                                                } else if (status == 'skipped') {
                                                                    hasSkipped = true
                                                                }
                                                            }
                                                        }
                                                        
                                                        if (hasPassed) {
                                                            passedTests++
                                                        } else if (hasFailed) {
                                                            failedTests++
                                                        } else if (hasSkipped) {
                                                            skippedTests++
                                                        } else {
                                                            skippedTests++
                                                        }
                                                    } else {
                                                        skippedTests++
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            echo "Parsed from suites: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                        } else {
                            echo "WARNING: No 'suites' array found in JSON"
                        }
                    }
                    
                    env.TEST_TOTAL = "${totalTests}"
                    env.TEST_PASSED = "${passedTests}"
                    env.TEST_FAILED = "${failedTests}"
                    env.TEST_SKIPPED = "${skippedTests}"
                    
                    echo "Final Test Summary: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    
                    if (totalTests == 0) {
                        echo "WARNING: Could not parse test results. JSON structure may be different."
                        if (resultsJson.containsKey('stats')) {
                            echo "Stats object exists but values are 0"
                        }
                        if (resultsJson.containsKey('suites')) {
                            echo "Suites array exists"
                        }
                    }
                }
            }
        }
        
        stage('Send to Slack') {
            steps {
                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
                    script {
                        def testJobUrl = "${env.JENKINS_URL}job/test_automation/"
                        def buildUrl = env.BUILD_URL ?: 'N/A'
                        
                        // 디버깅: 환경 변수 확인
                        echo "=== Step 4: Environment variables ==="
                        echo "TEST_TOTAL: ${env.TEST_TOTAL}"
                        echo "TEST_PASSED: ${env.TEST_PASSED}"
                        echo "TEST_FAILED: ${env.TEST_FAILED}"
                        echo "TEST_SKIPPED: ${env.TEST_SKIPPED}"
                        
                        // PowerShell에서 JSON을 직접 생성하여 한글 인코딩 문제 해결
                        def psScript = 'send_slack.ps1'
                        
                        // PowerShell 스크립트 파일 생성 (한글과 이모지를 PowerShell에서 직접 생성)
                        def psScriptContent = """
                            \$testTotal = '${env.TEST_TOTAL}'
                            \$testPassed = '${env.TEST_PASSED}'
                            \$testFailed = '${env.TEST_FAILED}'
                            \$testSkipped = '${env.TEST_SKIPPED}'
                            \$testJobUrl = '${testJobUrl}'
                            \$buildUrl = '${buildUrl}'
                            \$status = if ([int]\$testFailed -gt 0) { '❌ FAILED' } else { '✅ PASSED' }
                            \$color = if ([int]\$testFailed -gt 0) { 'danger' } else { 'good' }
                            \$webhookUrl = '${env.SLACK_WEBHOOK_URL}'
                            
                            # Slack 메시지 구성 (한글과 이모지 포함)
                            \$message = @"
🚀 *테스트 자동화 결과* `$status

📊 *테스트 요약*
• 전체: `$testTotal
• ✅ Passed: `$testPassed
• ❌ Failed: `$testFailed
• ⏭️ Skipped: `$testSkipped

🔗 *링크*
• 테스트 리포트: `$testJobUrl
• 빌드: `$buildUrl
"@
                            
                            # Slack payload 생성
                            \$payload = @{
                                text = \$message
                                username = 'Jenkins Test Bot'
                                icon_emoji = ':robot_face:'
                                attachments = @(
                                    @{
                                        color = \$color
                                        fields = @(
                                            @{ title = '전체'; value = \$testTotal; short = \$true }
                                            @{ title = '통과'; value = \$testPassed; short = \$true }
                                            @{ title = '실패'; value = \$testFailed; short = \$true }
                                            @{ title = '건너뜀'; value = \$testSkipped; short = \$true }
                                        )
                                    }
                                )
                            } | ConvertTo-Json -Depth 10
                            
                            # UTF-8 인코딩으로 바이트 변환
                            \$bytes = [System.Text.Encoding]::UTF8.GetBytes(\$payload)
                            
                            # Slack에 전송
                            Write-Host "Sending to Slack..."
                            Invoke-WebRequest -Uri \$webhookUrl -Method POST -ContentType 'application/json; charset=utf-8' -Body \$bytes -UseBasicParsing | Out-Null
                            Write-Host "Slack notification sent successfully"
                        """
                        // PowerShell 스크립트 파일을 UTF-8로 저장 (writeFile 사용)
                        writeFile file: psScript, text: psScriptContent, encoding: 'UTF-8'
                        
                        // PowerShell에서 UTF-8 BOM 추가 (한글 인코딩 문제 해결)
                        bat """
                            @echo off
                            powershell -Command "\$content = Get-Content -Path '%CD%\\${psScript}' -Raw -Encoding UTF8; \$utf8WithBom = New-Object System.Text.UTF8Encoding `$true; [System.IO.File]::WriteAllText('%CD%\\${psScript}', \$content, \$utf8WithBom)"
                        """
                        
                        // PowerShell 스크립트 실행
                        echo "=== Step 10: Executing PowerShell script ==="
                        bat """
                            @echo off
                            chcp 65001 >nul
                            powershell -ExecutionPolicy Bypass -File ${psScript}
                        """
                        
                        // 임시 파일 삭제
                        bat "del /f ${psScript}"
                        
                        echo 'Slack notification sent successfully'
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Slack notification pipeline completed'
        }
        failure {
            echo 'Failed to send Slack notification'
        }
    }
}

