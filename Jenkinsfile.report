pipeline {
    agent any
    
    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'Test build number to get results from')
    }
    
    environment {
        // 인코딩 설정 (한글 지원)
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8 -Dconsole.encoding=UTF-8'
        PYTHONIOENCODING = 'UTF-8'
        LANG = 'ko_KR.UTF-8'
        LC_ALL = 'ko_KR.UTF-8'
        
        // Slack Webhook URL 설정 방법:
        // 1. Jenkins 관리 → Credentials → Secret text 추가 (ID: slack-webhook-url)
        // 2. 또는 환경 변수로 직접 설정
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
    }
    
    stages {
        stage('Get Test Results') {
            steps {
                script {
                    def buildNumber = params.BUILD_NUMBER ?: "${env.BUILD_NUMBER}"
                    
                    // test_automation 파이프라인의 최신 빌드에서 아티팩트 가져오기
                    copyArtifacts(
                        projectName: 'test_automation',
                        selector: buildNumber ? specific(buildNumber) : lastSuccessful(),
                        filter: 'test-results/results.json',
                        target: '.',
                        flatten: true
                    )
                    
                    if (!fileExists('results.json')) {
                        error 'Test results file not found. Make sure test_automation job completed successfully.'
                    }
                }
            }
        }
        
        stage('Parse Test Results') {
            steps {
                script {
                    def resultsJson = readJSON file: 'results.json'
                    
                    // JSON 구조 디버깅
                    echo "JSON top-level keys: ${resultsJson.keySet()}"
                    
                    // Playwright JSON 리포트 구조에 맞게 파싱
                    def totalTests = 0
                    def passedTests = 0
                    def failedTests = 0
                    def skippedTests = 0
                    
                    // Sandbox가 비활성화되어 있으므로 클로저 사용 가능
                    def countTests = { obj, counters ->
                        if (obj instanceof Map) {
                            // test 객체인지 확인 (results 배열이 있으면 test)
                            if (obj.containsKey('results') && obj.results instanceof List) {
                                counters.total++
                                def hasPassed = false
                                def hasFailed = false
                                
                                obj.results.each { result ->
                                    if (result instanceof Map && result.status) {
                                        if (result.status == 'passed') {
                                            hasPassed = true
                                        } else if (result.status == 'failed') {
                                            hasFailed = true
                                        }
                                    }
                                }
                                
                                if (hasPassed) {
                                    counters.passed++
                                } else if (hasFailed) {
                                    counters.failed++
                                } else {
                                    counters.skipped++
                                }
                            } else {
                                // Map의 모든 값에 대해 재귀 호출
                                obj.each { key, value ->
                                    countTests(value, counters)
                                }
                            }
                        } else if (obj instanceof List) {
                            // List의 모든 요소에 대해 재귀 호출
                            obj.each { item ->
                                countTests(item, counters)
                            }
                        }
                    }
                    
                    // 카운터 맵 생성
                    def counters = [
                        total: 0,
                        passed: 0,
                        failed: 0,
                        skipped: 0
                    ]
                    
                    // JSON 전체를 순회하며 테스트 카운트
                    countTests(resultsJson, counters)
                    
                    totalTests = counters.total
                    passedTests = counters.passed
                    failedTests = counters.failed
                    skippedTests = counters.skipped
                    
                    // 결과가 0이면 대체 방법 시도
                    if (totalTests == 0) {
                        echo "No tests found with recursive method, trying alternative parsing..."
                        
                        // 방법 1: suites 배열 직접 접근
                        if (resultsJson.suites instanceof List) {
                            resultsJson.suites.each { suite ->
                                if (suite instanceof Map) {
                                    if (suite.specs instanceof List) {
                                        suite.specs.each { spec ->
                                            if (spec instanceof Map && spec.tests instanceof List) {
                                                spec.tests.each { test ->
                                                    totalTests++
                                                    if (test instanceof Map && test.results instanceof List) {
                                                        def status = test.results.find { it.status }?.status
                                                        if (status == 'passed') {
                                                            passedTests++
                                                        } else if (status == 'failed') {
                                                            failedTests++
                                                        } else {
                                                            skippedTests++
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // 방법 2: stats 객체 사용
                        if (totalTests == 0 && resultsJson.stats instanceof Map) {
                            totalTests = resultsJson.stats.total ?: 0
                            passedTests = resultsJson.stats.passed ?: 0
                            failedTests = resultsJson.stats.failed ?: 0
                            skippedTests = resultsJson.stats.skipped ?: 0
                        }
                    }
                    
                    env.TEST_TOTAL = "${totalTests}"
                    env.TEST_PASSED = "${passedTests}"
                    env.TEST_FAILED = "${failedTests}"
                    env.TEST_SKIPPED = "${skippedTests}"
                    
                    echo "Test Summary: Total=${totalTests}, Passed=${passedTests}, Failed=${failedTests}, Skipped=${skippedTests}"
                    
                    if (totalTests == 0) {
                        echo "WARNING: Could not parse test results. JSON structure may be different."
                        echo "First 500 characters of JSON: ${groovy.json.JsonOutput.toJson(resultsJson).take(500)}"
                    }
                }
            }
        }
        
        stage('Send to Slack') {
            steps {
                script {
                    def testJobUrl = "${env.JENKINS_URL}job/test_automation/"
                    def buildUrl = env.BUILD_URL ?: 'N/A'
                    def status = env.TEST_FAILED.toInteger() > 0 ? '❌ FAILED' : '✅ PASSED'
                    def color = env.TEST_FAILED.toInteger() > 0 ? 'danger' : 'good'
                    
                    // Slack 메시지 구성 (영문 사용으로 인코딩 문제 방지)
                    def message = """
🚀 *Test Automation Results* ${status}

📊 *Test Summary*
• Total: ${env.TEST_TOTAL}
• ✅ Passed: ${env.TEST_PASSED}
• ❌ Failed: ${env.TEST_FAILED}
• ⏭️ Skipped: ${env.TEST_SKIPPED}

🔗 *Links*
• Test Report: ${testJobUrl}
• Build: ${buildUrl}
"""
                    
                    // Slack 전송 (HTTP POST)
                    def payload = [
                        text: message,
                        username: 'Jenkins Test Bot',
                        icon_emoji: ':robot_face:',
                        attachments: [[
                            color: color,
                            fields: [
                                [title: 'Total', value: env.TEST_TOTAL, short: true],
                                [title: 'Passed', value: env.TEST_PASSED, short: true],
                                [title: 'Failed', value: env.TEST_FAILED, short: true],
                                [title: 'Skipped', value: env.TEST_SKIPPED, short: true]
                            ]
                        ]]
                    ]
                    
                    // UTF-8 인코딩으로 JSON 생성
                    def jsonPayload = groovy.json.JsonOutput.toJson(payload)
                    
                    // HTTP Request에서 UTF-8 charset 명시
                    httpRequest(
                        httpMode: 'POST',
                        url: "${env.SLACK_WEBHOOK_URL}",
                        contentType: 'APPLICATION_JSON; charset=UTF-8',
                        requestBody: jsonPayload,
                        validResponseCodes: '200:299'
                    )
                    
                    echo 'Slack notification sent successfully'
                }
            }
        }
    }
    
    post {
        always {
            echo 'Slack notification pipeline completed'
        }
        failure {
            echo 'Failed to send Slack notification'
        }
    }
}

